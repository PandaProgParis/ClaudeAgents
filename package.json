{
  "name": "claude-agents",
  "displayName": "Claude Agent Map & Usage",
  "description": "Agent map of every Claude Code session on your machine - sessions, sub-agents, workflows, prompt cache - plus your plan usage with reset countdowns in the sidebar and the status bar. Read-only access to ~/.claude.",
  "version": "1.0.0",
  "publisher": "pandaprog",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PandaProgParis/ClaudeAgents.git"
  },
  "bugs": {
    "url": "https://github.com/PandaProgParis/ClaudeAgents/issues"
  },
  "homepage": "https://github.com/PandaProgParis/ClaudeAgents#readme",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "claude",
    "claude code",
    "agents",
    "agent map",
    "sub-agents",
    "usage",
    "monitoring",
    "ai"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-agents",
          "title": "Claude Agents",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "claude-agents": [
        {
          "type": "webview",
          "id": "claudeAgentsCards",
          "name": "%view.sessions%"
        }
      ]
    },
    "commands": [
      {
        "command": "claudeAgents.focusCurrentProject",
        "title": "%command.focusCurrentProject%",
        "category": "Claude Agents",
        "icon": "$(filter)"
      },
      {
        "command": "claudeAgents.showAllProjects",
        "title": "%command.showAllProjects%",
        "category": "Claude Agents",
        "icon": "$(filter-filled)"
      },
      {
        "command": "claudeAgents.openSettings",
        "title": "%command.openSettings%",
        "category": "Claude Agents",
        "icon": "$(gear)"
      },
      {
        "command": "claudeAgents.usageStatusBarMenu",
        "title": "%command.usageStatusBarMenu%",
        "category": "Claude Agents",
        "icon": "$(chevron-down)"
      }
    ],
    "icons": {
      "claude-agents-ring-0": {
        "description": "Claude usage ring, 0/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E000"
        }
      },
      "claude-agents-ring-1": {
        "description": "Claude usage ring, 1/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E001"
        }
      },
      "claude-agents-ring-2": {
        "description": "Claude usage ring, 2/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E002"
        }
      },
      "claude-agents-ring-3": {
        "description": "Claude usage ring, 3/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E003"
        }
      },
      "claude-agents-ring-4": {
        "description": "Claude usage ring, 4/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E004"
        }
      },
      "claude-agents-ring-5": {
        "description": "Claude usage ring, 5/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E005"
        }
      },
      "claude-agents-ring-6": {
        "description": "Claude usage ring, 6/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E006"
        }
      },
      "claude-agents-ring-7": {
        "description": "Claude usage ring, 7/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E007"
        }
      },
      "claude-agents-ring-8": {
        "description": "Claude usage ring, 8/8",
        "default": {
          "fontPath": "./media/usage-rings.woff",
          "fontCharacter": "\\E008"
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "claudeAgents.focusCurrentProject",
          "when": "view == claudeAgentsCards && !claudeAgents.currentProjectOnly",
          "group": "navigation@1"
        },
        {
          "command": "claudeAgents.showAllProjects",
          "when": "view == claudeAgentsCards && claudeAgents.currentProjectOnly",
          "group": "navigation@1"
        },
        {
          "command": "claudeAgents.openSettings",
          "when": "view == claudeAgentsCards",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Claude Agents",
      "properties": {
        "claudeAgents.showFinishedAgents": {
          "type": "string",
          "enum": [
            "always",
            "temporarily",
            "never"
          ],
          "default": "temporarily",
          "markdownDescription": "%config.showFinishedAgents%"
        },
        "claudeAgents.finishedAgentRetentionSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "markdownDescription": "%config.finishedAgentRetentionSeconds%"
        },
        "claudeAgents.inactiveSessionRetentionMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "markdownDescription": "%config.inactiveSessionRetentionMinutes%"
        },
        "claudeAgents.alwaysShowWorkspaceSessions": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.alwaysShowWorkspaceSessions%"
        },
        "claudeAgents.showUsage": {
          "type": "boolean",
          "default": true,
          "description": "%config.showUsage%"
        },
        "claudeAgents.usageFile": {
          "type": "string",
          "default": "",
          "description": "%config.usageFile%"
        },
        "claudeAgents.usageStatusBar": {
          "type": "string",
          "enum": [
            "text",
            "rings",
            "off"
          ],
          "enumDescriptions": [
            "%config.usageStatusBar.text%",
            "%config.usageStatusBar.rings%",
            "%config.usageStatusBar.off%"
          ],
          "default": "text",
          "markdownDescription": "%config.usageStatusBar%"
        },
        "claudeAgents.usageStatusBarSide": {
          "type": "string",
          "enum": [
            "right",
            "left"
          ],
          "default": "right",
          "markdownDescription": "%config.usageStatusBarSide%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "dev": "node esbuild.mjs --dev",
    "typecheck": "tsc --noEmit",
    "font": "esbuild src/font/writeRingFont.ts --bundle --platform=node --outfile=dist/write-ring-font.js --log-level=warning && node dist/write-ring-font.js",
    "test": "vitest run",
    "vscode:prepublish": "npm run build",
    "package": "npm run typecheck && npm run test && vsce package"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.1",
    "happy-dom": "^20.10.6",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
